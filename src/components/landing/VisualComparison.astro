<section class="section visual-results" aria-labelledby="visual-heading">
  <div class="container visual-results__grid">
    <div class="visual-results__copy">
      <p class="eyebrow">Product visuals, refined</p>
      <h2 id="visual-heading">From quick product shot to storefront ready.</h2>
      <p>Remove visual distractions, improve detail, and build a professional product presentation from the asset you already have.</p>
      <ul>
        <li><span>01</span><div><b>Remove or replace the background</b><p>Start with a clean cutout or a new studio setting.</p></div></li>
        <li><span>02</span><div><b>Enhance product detail</b><p>Improve clarity and resolution for high-impact placements.</p></div></li>
        <li><span>03</span><div><b>Keep the product recognizable</b><p>Review every result before it moves into your store.</p></div></li>
      </ul>
    </div>
    <div class="comparison" data-comparison>
      <div class="comparison__stage">
        <img class="comparison__image comparison__image--before" src="/product-bottle.jpg" width="800" height="800" alt="Original product photo before enhancement" loading="lazy" />
        <div class="comparison__after" data-after>
          <img class="comparison__image comparison__image--after" src="/product-bottle.jpg" width="800" height="800" alt="Enhanced product photo with a brighter studio treatment" loading="lazy" />
        </div>
        <span class="comparison__label comparison__label--before">Before</span>
        <span class="comparison__label comparison__label--after">After</span>
        <div class="comparison__line" data-line aria-hidden="true"><span></span></div>
      </div>
      <label for="comparison-range">Compare before and after</label>
      <input id="comparison-range" data-range type="range" min="5" max="95" value="54" aria-valuetext="Comparison divider at 54 percent" />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-comparison]").forEach((comparison) => {
    const range = comparison.querySelector<HTMLInputElement>("[data-range]");
    const after = comparison.querySelector<HTMLElement>("[data-after]");
    const line = comparison.querySelector<HTMLElement>("[data-line]");
    if (!range || !after || !line) return;
    const update = () => {
      const value = range.value;
      after.style.clipPath = `inset(0 0 0 ${value}%)`;
      line.style.left = `${value}%`;
      range.setAttribute("aria-valuetext", `Comparison divider at ${value} percent`);
    };
    range.addEventListener("input", update);
    update();
  });
</script>
