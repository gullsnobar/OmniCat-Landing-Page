---
import { Image } from "astro:assets";
import ToolIcon from "../ui/ToolIcon";
import serumPlinth from "../../assets/features/serum-plinth.jpg";
import modelPortrait from "../../assets/features/model-portrait.jpg";
import serumBotanical from "../../assets/features/serum-botanical.jpg";
import creamJar from "../../assets/features/cream-jar.jpg";

const benefits = [
  { icon: "LayoutDashboard", title: "One dashboard", text: "Switch between copy and visuals without losing context." },
  { icon: "Coins", title: "Clear credit costs", text: "See the cost before every job. Failed jobs are refunded automatically." },
  { icon: "History", title: "History you can reuse", text: "Return to past results and reuse what worked." },
];

const jobs = [
  { thumb: serumPlinth, tool: "Product description", name: "Amber Renewal Serum", meta: "Ready · 8 credits", time: "Now" },
  { thumb: modelPortrait, tool: "Ad copy", name: "Autumn launch campaign", meta: "Ready · 12 credits", time: "4m" },
  { thumb: serumBotanical, tool: "Photo enhancer", name: "Catalog batch 12", meta: "12 images · 64 credits", time: "18m" },
  { thumb: creamJar, tool: "Background generator", name: "Barrier Cream", meta: "Failed · 6 credits refunded", time: "1h", refunded: true },
];
---

<section class="section workspace" aria-labelledby="workspace-heading">
  <div class="container workspace__grid">
    <div class="workspace__copy">
      <p class="eyebrow eyebrow--light">Everything in one workspace</p>
      <h2 id="workspace-heading">Replace the tool shuffle with one connected flow.</h2>
      <p class="workspace__lead">Copy, visuals, and every past result live next to your products.</p>
      <ul class="workspace__benefits">
        {benefits.map((benefit) => (
          <li>
            <span aria-hidden="true"><ToolIcon name={benefit.icon} size={20} /></span>
            <div>
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="workspace-panel" aria-label="OmniCat generation history preview">
      <div class="workspace-panel__top">
        <div><span aria-hidden="true">O</span><b>Generation history</b></div>
        <small>Today</small>
      </div>
      <div class="workspace-panel__summary">
        <div><b>8</b><small>Jobs completed</small></div>
        <div><b>2,418</b><small>Credits left</small></div>
      </div>
      <ul class="history-list">
        {jobs.map((job) => (
          <li class:list={{ "is-refunded": job.refunded }}>
            <Image src={job.thumb} alt="" widths={[96, 192]} sizes="48px" />
            <div>
              <small>{job.tool}</small>
              <b>{job.name}</b>
              <span>{job.meta}</span>
            </div>
            <em>{job.time}</em>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
