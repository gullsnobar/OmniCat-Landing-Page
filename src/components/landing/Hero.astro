---
---

<section class="hero section" id="product" aria-labelledby="hero-heading" style="scroll-mt: 96px">
  <div class="container hero__grid">
    <div class="hero__content reveal">
      <p class="eyebrow">The AI creative workspace for modern commerce</p>
      <h1 id="hero-heading">Turn product ideas into <em>content that sells.</em></h1>
      <p class="hero__lead">Create product descriptions, campaign copy, and studio-quality product visuals from one focused workspace built for Shopify merchants.</p>
      <div class="hero__actions">
        <a class="button button--primary button--large" href="/register">Start creating free</a>
        <a class="button button--secondary button--large" href="#features">Explore the tools</a>
      </div>
      <p class="hero__trust">Works inside your Shopify admin · No coding needed</p>
    </div>

    <div class="hero-preview reveal reveal--delay" aria-label="OmniCat product workspace preview">
      <div class="preview-window">
        <div class="preview-topbar">
          <div class="preview-topbar__dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="preview-topbar__title">OmniCat Studio Bottle 01</span>
          <div class="credit-pill"><span></span> 864 credits</div>
        </div>
        <div class="preview-body">
          <aside class="preview-sidebar" aria-label="Preview navigation">
            <p>Workspace</p>
            <span class="is-active">Create</span>
            <span>Products</span>
            <span>History</span>
            <span>Brand kit</span>
          </aside>
          <div class="preview-main">
            <div class="preview-heading">
              <div><small>SHOPIFY PRODUCT</small><h2>Studio Bottle 01</h2></div>
              <span class="status status--ready"><i></i>Ready to publish</span>
            </div>
            <div class="product-editor">
              <div class="product-media">
                <div class="product-media__label">Enhanced</div>
                <img src="/product-bottle.jpg" width="560" height="700" alt="White skincare bottle on a bright neutral surface" fetchpriority="high" />
                <div class="enhance-state"><span></span>Image enhanced</div>
              </div>
              <div class="copy-panel">
                <div class="copy-panel__header"><span>Product description</span><small>Generated</small></div>
                <h3>A daily ritual for calm, balanced skin.</h3>
                <p>A lightweight botanical serum designed to replenish moisture and soften the look of texture without weighing skin down.</p>
                <ul>
                  <li>Fast-absorbing, non-greasy finish</li>
                  <li>Made for everyday routines</li>
                  <li>Clean, considered presentation</li>
                </ul>
                <div class="copy-panel__footer">
                  <span>SEO optimized</span>
                  <button type="button">Apply to Shopify</button>
                </div>
              </div>
            </div>
            <div class="job-bar">
              <div><span class="job-dot"></span><strong>2 assets ready</strong><small>Description + enhanced image</small></div>
              <span class="job-cost">36 credits used</span>
            </div>
          </div>
        </div>
      </div>
      <div class="preview-note preview-note--top" aria-hidden="true">
        <span>01</span>One product in. A campaign out.
      </div>
      <div class="preview-note preview-note--bottom" aria-hidden="true">
        <b>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </b>
        Changes saved to draft
      </div>
    </div>
  </div>
</section>

<section class="value-strip" aria-label="Product benefits">
  <div class="value-strip__benefits">
    <ul class="container" aria-label="Key benefits">
      {['Built for Shopify', 'Review before publishing', 'Refunds for failed jobs'].map((benefit) => (
        <li>
          <span aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 4.9 8.5 9.5 3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          {benefit}
        </li>
      ))}
    </ul>
  </div>
  <div class="value-strip__cards">
    <div class="container value-strip__grid">
      <article><b>01</b><div><h2>Shopify-ready workflow</h2><p>Create from the product you already manage.</p></div></article>
      <article><b>02</b><div><h2>Content + images</h2><p>Move from words to visuals in one session.</p></div></article>
      <article><b>03</b><div><h2>Batch-friendly</h2><p>Keep larger catalog updates moving.</p></div></article>
      <article><b>04</b><div><h2>Automatic refunds</h2><p>Failed AI jobs return their credits.</p></div></article>
    </div>
  </div>
</section>
