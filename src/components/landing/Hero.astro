---
import { Image } from "astro:assets";
import { appLinks } from "../../config/app-links";
import serumPlinth from "../../assets/features/serum-plinth.jpg";

const trust = ["100 free credits daily", "No credit card", "You approve every change"];
const check = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
---

<section class="hero section" id="product" aria-labelledby="hero-heading" style="scroll-mt: 96px">
  <div class="container hero__grid">
    <div class="hero__content reveal">
      <p class="hero__badge"><i aria-hidden="true"></i>AI content and visuals for Shopify</p>
      <h1 id="hero-heading">Turn product ideas into <em>content that sells.</em></h1>
      <p class="hero__lead">Write product copy and create studio-quality photos in one workspace built for Shopify.</p>
      <div class="hero__actions">
        <a class="button button--primary button--large" href={appLinks.signup}>Start free</a>
        <a class="button button--secondary button--large" href="#features">Explore the tools</a>
      </div>
      <ul class="hero__trust" aria-label="Why merchants start with OmniCat">
        {trust.map((item) => <li><Fragment set:html={check} />{item}</li>)}
      </ul>
    </div>

    <div class="hero-shot reveal reveal--delay" aria-label="OmniCat product editor preview">
      <div class="hero-shot__window">
        <div class="hero-shot__bar">
          <span class="hero-shot__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="hero-shot__title">Amber Renewal Serum</span>
          <span class="hero-shot__credits"><i aria-hidden="true"></i>864 credits</span>
        </div>
        <div class="hero-shot__body">
          <figure class="hero-shot__media">
            <Image
              src={serumPlinth}
              alt="Amber serum bottle on a sunlit plinth, enhanced by OmniCat"
              widths={[360, 640, 900]}
              sizes="(max-width: 640px) 92vw, (max-width: 899px) 45vw, 320px"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption><Fragment set:html={check} />Enhanced 4×</figcaption>
          </figure>
          <div class="hero-shot__copy">
            <div class="hero-shot__label"><span>Product description</span><b>Generated</b></div>
            <strong>Overnight renewal, bottled.</strong>
            <p>A lightweight bakuchiol serum that smooths texture while you sleep.</p>
            <ul>
              <li><Fragment set:html={check} />Fragrance-free formula</li>
              <li><Fragment set:html={check} />Absorbs in seconds</li>
              <li><Fragment set:html={check} />Made for nightly use</li>
            </ul>
            <div class="hero-shot__footer">
              <small>SEO-ready</small>
              <span>Apply to Shopify</span>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-shot__toast" aria-hidden="true">
        <b><Fragment set:html={check} /></b>
        <span><strong>Published to Shopify</strong><small>Copy and 3 images</small></span>
      </div>
    </div>
  </div>
</section>
