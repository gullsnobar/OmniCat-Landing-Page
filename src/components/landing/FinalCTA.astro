---
import { appLinks } from "../../config/app-links";
---

<section class="section final-cta" aria-labelledby="final-heading">
  <div class="container">
    <div class="final-cta__inner">
      <h2 id="final-heading">Create better product content in less time.</h2>
      <p>Bring copywriting, image enhancement, and Shopify publishing together in one focused workspace.</p>
      <div class="final-cta__actions">
        <a class="button button--light button--large" href={appLinks.signup}>Sign up free</a>
        <a class="button button--dark-ghost button--large" href={appLinks.login}>Log in</a>
      </div>
      <small>100 free credits daily · No credit card required</small>
    </div>
  </div>
</section>
