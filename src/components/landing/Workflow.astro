---
const steps = [
  { number: "01", title: "Open a product", text: "Start from a Shopify product or add a focused creative brief." },
  { number: "02", title: "Choose your tool", text: "Write new content, refine imagery, or prepare a full product update." },
  { number: "03", title: "Generate and review", text: "Compare the output, make edits, and keep the version that fits your brand." },
  { number: "04", title: "Apply to Shopify", text: "Publish only the approved copy and images when you are ready.", tag: "Merchant approved" },
];
---

<section class="section workflow" aria-labelledby="workflow-heading" style="scroll-mt: 96px">
  <div class="container">
    <div class="section-intro section-intro--split">
      <div>
        <p class="eyebrow">Shopify workflow</p>
        <h2 id="workflow-heading">From product page to publish-ready.</h2>
      </div>
      <p>You stay in control at every step. OmniCat prepares the work; you review and approve what reaches your store.</p>
    </div>
    <ol class="workflow-line">
      {steps.map((step) => (
        <li>
          <div class="workflow-line__number">{step.number}</div>
          <div class="workflow-line__connector" aria-hidden="true"><span></span></div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          {step.tag && <span class="workflow-line__tag">{step.tag}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>
