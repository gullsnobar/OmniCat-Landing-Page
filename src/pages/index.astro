---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Features from "../components/landing/Features.astro";
import Workspace from "../components/landing/Workspace.astro";
import VisualComparison from "../components/landing/VisualComparison.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Pricing from "../components/landing/Pricing.astro";
import FAQ from "../components/landing/FAQ.astro";
import FinalCTA from "../components/landing/FinalCTA.astro";
import Footer from "../components/landing/Footer.astro";
---

<Layout
  title="OmniCat | AI content and product visuals for Shopify"
  description="Create product descriptions, campaign copy, and studio-quality product visuals from one AI workspace built for Shopify merchants."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Features />
    <Workspace />
    <VisualComparison />
    <HowItWorks />
    <Pricing />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
